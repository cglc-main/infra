  {
   "type": "stat",
   "id": 11,
   "title": "Pending pods' memory",
   "description": "Memory requested by pods that wait for a node: how much room is missing.",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "sum(kube_pod_container_resource_requests{resource=\"memory\"} * on (namespace, pod) group_left () (kube_pod_status_phase{phase=\"Pending\"} == 1)) or vector(0)",
     "instant": true,
     "range": false
