     "expr": "(count(kube_deployment_status_replicas_unavailable > 0) or vector(0)) + (count(kube_daemonset_status_number_unavailable > 0) or vector(0)) + (count(kube_statefulset_status_replicas - kube_statefulset_status_replicas_ready > 0) or vector(0))",
