  {
   "type": "table",
   "id": 17,
   "title": "Nodes",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "h": 6,
    "w": 24,
    "x": 0,
    "y": 18
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "max by (node) (kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "1 - sum by (node) (label_replace(node_memory_MemAvailable_bytes, \"internal_ip\", \"$1\", \"instance\", \"([^:]+):.*\") * on (internal_ip) group_left (node) max by (internal_ip, node) (kube_node_info)) / sum by (node) (label_replace(node_memory_MemTotal_bytes, \"internal_ip\", \"$1\", \"instance\", \"([^:]+):.*\") * on (internal_ip) group_left (node) max by (internal_ip, node) (kube_node_info))",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "max by (node) (label_replace(node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}, \"internal_ip\", \"$1\", \"instance\", \"([^:]+):.*\") * on (internal_ip) group_left (node) max by (internal_ip, node) (kube_node_info))",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "count by (node) (kube_pod_info{node!=\"\"} * on (namespace, pod) group_left () (kube_pod_status_phase{phase=\"Running\"} == 1))",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "E",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "max by (node) (label_replace(node_boot_time_seconds, \"internal_ip\", \"$1\", \"instance\", \"([^:]+):.*\") * on (internal_ip) group_left (node) max by (internal_ip, node) (kube_node_info)) * 1000",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "F",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "max by (node, kubelet_version) (kube_node_info)",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
